# ── SovereignAudit v2.0 — Environment Variables ───────────────────────────────
# Copy to .env and fill in your values before deploying.
# NEVER commit .env to version control.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Google AI Studio (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# App security
APP_SECRET_KEY=change-me-to-a-random-64-char-string

# Frontend (set in Vercel dashboard too)
NEXT_PUBLIC_API_URL=https://your-hf-space.hf.space
